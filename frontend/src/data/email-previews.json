  "welcome": "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><meta name=\"color-scheme\" content=\"light\"><title>Welcome to AlignNova</title>\n<style>@media only screen and (max-width:480px) { .mail-outer { padding:16px 8px!important; } .mail-body { padding:28px 22px!important; } .mail-header { padding:22px!important; } }</style></head>\n<body style=\"margin:0;padding:0;background-color:#f8f7f2;color:#202e2d;font-family:Arial, Helvetica, sans-serif;-webkit-text-size-adjust:100%;\">\n<div style=\"display:none;font-size:1px;line-height:1px;color:#f8f7f2;max-height:0;max-width:0;opacity:0;overflow:hidden;mso-hide:all;\">Your campus workspace is ready. Set your password to get started.</div>\n<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" bgcolor=\"#f8f7f2\" style=\"background:#f8f7f2;\"><tr><td class=\"mail-outer\" align=\"center\" style=\"padding:40px 16px;\">\n<!--[if mso]><table role=\"presentation\" width=\"600\" align=\"center\"><tr><td><![endif]-->\n<table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" bgcolor=\"#fffefa\" style=\"max-width:600px;background:#fffefa;border:1px solid #cdd3c5;border-radius:4px;border-spacing:0;\">\n<tr><td class=\"mail-header\" style=\"padding:26px 36px;border-bottom:1px solid #cdd3c5;\">\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\"><tr><td width=\"38\" height=\"38\" align=\"center\" bgcolor=\"#263e36\" style=\"background:#263e36;border-radius:3px;color:#ffffff;font:34px/38px Georgia, 'Times New Roman', serif;\">a<span style=\"color:#e1bca6;\">.</span></td><td style=\"padding-left:12px;color:#202e2d;font:bold 23px/1.2 Arial, Helvetica, sans-serif;letter-spacing:-1px;\">AlignNova</td></tr></table>\n</td></tr>\n<tr><td class=\"mail-body\" style=\"padding:36px;\">\n<p style=\"margin:0 0 20px;color:#a6442c;font:bold 10px/1.7 Arial, Helvetica, sans-serif;letter-spacing:1.7px;\">YOUR NEXT CHAPTER</p>\n<h1 style=\"margin:0 0 22px;color:#202e2d;font:normal 34px/1.15 Georgia, 'Times New Roman', serif;letter-spacing:-.8px;\">Welcome to AlignNova,<br>PREVIEW_RECIPIENT_NAME.</h1><p style=\"margin:0 0 20px;color:#626760;font:15px/1.75 Arial, Helvetica, sans-serif;\">Your placement team has invited you to AlignNova. Set your password to access your profile, campus opportunities, and applications.</p><table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"margin:28px 0 16px;\">\n<tr><td bgcolor=\"#263e36\" style=\"background:#263e36;border-radius:3px;text-align:center;mso-padding-alt:16px 26px;\">\n<a href=\"#preview-activation\" style=\"display:inline-block;padding:16px 26px;border:1px solid #263e36;border-radius:3px;color:#ffffff;text-decoration:none;font:bold 14px/1.3 Arial, Helvetica, sans-serif;\">Set your password &rarr;</a>\n</td></tr></table>\n<p style=\"margin:0 0 22px;color:#626760;font:12px/1.6 Arial, Helvetica, sans-serif;\">This invitation is valid for 7 days and can be used once.</p>\n<p style=\"margin:0 0 6px;color:#626760;font:12px/1.6 Arial, Helvetica, sans-serif;\">If the button doesn’t work, copy this link into your browser:</p>\n<p style=\"margin:0 0 26px;font:12px/1.6 Arial, Helvetica, sans-serif;word-break:break-all;overflow-wrap:anywhere;\"><a href=\"#preview-activation\" style=\"color:#a6442c;text-decoration:underline;\">#preview-activation</a></p><p style=\"margin:0 0 20px;color:#626760;font:15px/1.75 Arial, Helvetica, sans-serif;\">Invitation expired? <a href=\"#preview-renewal\" style=\"color:#a6442c;text-decoration:underline;\">Request a new activation link</a>.</p><table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"border-collapse:collapse;margin-top:28px;\"><tr><td width=\"32\" valign=\"top\" style=\"padding:14px 12px 14px 0;border-top:1px solid #cdd3c5;color:#a6442c;font:italic 18px Georgia, 'Times New Roman', serif;\">01</td>\n<td style=\"padding:14px 0;border-top:1px solid #cdd3c5;\"><p style=\"margin:0 0 4px;color:#202e2d;font:bold 14px/1.5 Arial, Helvetica, sans-serif;\">Make your profile yours.</p><p style=\"margin:0;color:#626760;font:13px/1.7 Arial, Helvetica, sans-serif;\">Add your academic records, experience, and resume.</p></td></tr><tr><td width=\"32\" valign=\"top\" style=\"padding:14px 12px 14px 0;border-top:1px solid #cdd3c5;color:#a6442c;font:italic 18px Georgia, 'Times New Roman', serif;\">02</td>\n<td style=\"padding:14px 0;border-top:1px solid #cdd3c5;\"><p style=\"margin:0 0 4px;color:#202e2d;font:bold 14px/1.5 Arial, Helvetica, sans-serif;\">Find the right drives.</p><p style=\"margin:0;color:#626760;font:13px/1.7 Arial, Helvetica, sans-serif;\">Browse opportunities that match your course and academic criteria.</p></td></tr><tr><td width=\"32\" valign=\"top\" style=\"padding:14px 12px 14px 0;border-top:1px solid #cdd3c5;color:#a6442c;font:italic 18px Georgia, 'Times New Roman', serif;\">03</td>\n<td style=\"padding:14px 0;border-top:1px solid #cdd3c5;\"><p style=\"margin:0 0 4px;color:#202e2d;font:bold 14px/1.5 Arial, Helvetica, sans-serif;\">Keep your next step in sight.</p><p style=\"margin:0;color:#626760;font:13px/1.7 Arial, Helvetica, sans-serif;\">Apply and follow updates from your placement team.</p></td></tr></table>\n</td></tr>\n<tr><td style=\"padding:22px 36px;background:#e8ebe2;border-top:1px solid #cdd3c5;\">\n<p style=\"margin:0 0 6px;color:#202e2d;font:bold 12px/1.6 Arial, Helvetica, sans-serif;\">Your campus placement workspace.</p>\n<p style=\"margin:0;color:#626760;font:12px/1.7 Arial, Helvetica, sans-serif;\">Sent by AlignNova. For help, contact your campus placement team.</p>\n<p style=\"margin:14px 0 0;color:#626760;font:11px/1.6 Arial, Helvetica, sans-serif;\">&copy; 2026 AlignNova</p>\n</td></tr></table>\n<!--[if mso]></td></tr></table><![endif]-->\n</td></tr></table></body></html>",
