{
  "name": "alignnova-frontend",
  "version": "1.0.0",
  "private": true,
  "devDependencies": {
    "autoprefixer": "^10.4.14",
    "postcss": "^8.4.23",
    "tailwindcss": "^3.4.7",
    "@tailwindcss/forms": "^0.5.4"
  },
  "scripts": {
    "build:css": "cd frontend && ../node_modules/.bin/tailwindcss -c ./tailwind.config.js -i ./src/index.css -o ./styles.css --minify",
    "watch:css": "cd frontend && ../node_modules/.bin/tailwindcss -c ./tailwind.config.js -i ./src/index.css -o ./styles.css --watch"
  }
}
